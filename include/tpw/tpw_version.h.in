/**
 * @file tpw_version.h
 * @brief Compile-time library version, generated from the project's meson
 *        version at build time.
 */

#ifndef TPW_VERSION_H
#define TPW_VERSION_H

#define TPW_VERSION_MAJOR @TPW_VERSION_MAJOR@
#define TPW_VERSION_MINOR @TPW_VERSION_MINOR@
#define TPW_VERSION_PATCH @TPW_VERSION_PATCH@

/** @brief True if this header declares at least major.minor.patch. */
#define TPW_CHECK_VERSION(major, minor, patch) \
    (TPW_VERSION_MAJOR > (major) || \
     (TPW_VERSION_MAJOR == (major) && TPW_VERSION_MINOR > (minor)) || \
     (TPW_VERSION_MAJOR == (major) && TPW_VERSION_MINOR == (minor) && TPW_VERSION_PATCH >= (patch)))

#endif /* TPW_VERSION_H */
